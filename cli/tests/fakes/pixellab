#!/bin/sh
# A stand-in for Pixel Lab's pixellab in tests. Logs every call to
# $FAKE_PIXELLAB_LOG and answers the commands pixelreel uses; art export
# writes test frames with ffmpeg.
echo "$*" >> "$FAKE_PIXELLAB_LOG"
doc=""
args=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json) shift ;;
    --document) doc="$2"; shift 2 ;;
    *) args="$args
$1"; shift ;;
  esac
done
set -f
IFS='
'
set -- $args
case "$1 $2" in
  "scene list") echo '{"scenes":[{"name":"farm"}]}' ;;
  "sequence list") echo '{"sequences":[]}' ;;
  "scene show") echo "{\"name\":\"$3\",\"period\":4000}" ;;
  "document copy") cp -R "$doc" "$4"; echo '{}' ;;
  "scene motion"|"scene key") echo '{}' ;;
  "art export")
    name="$3"; out="$4"; shift 4
    fit=""; fps=30; from=0; to=1000
    while [ $# -gt 0 ]; do
      case "$1" in
        --fit) fit="$2"; shift 2 ;;
        --fps) fps="$2"; shift 2 ;;
        --from) from="$2"; shift 2 ;;
        --to) to="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    size=$(echo "$fit" | tr ',' 'x')
    dur=$(awk "BEGIN { print ($to - $from) / 1000 }")
    mkdir -p "$out"
    ffmpeg -hide_banner -loglevel error -nostdin -f lavfi -i "testsrc2=s=$size:r=$fps:d=$dur" "$out/%04d.png" || exit 1
    echo '{}' ;;
  *) echo "{\"error\":{\"message\":\"unknown command $1 $2\"}}" >&2; exit 1 ;;
esac
